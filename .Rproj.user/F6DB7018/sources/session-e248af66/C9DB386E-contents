############################################################
####### Popisná statistika
############################################################

# průměr
soucet <- sum(data5$y)
soucet
n <- length(data5$y)
n
prumer <- soucet/n
prumer

mean(data4$y)   # nativní funkce pro průměru v R

# variance/rozptyl: součet čtverců odchylek od průměru (SS) / stupně volnosti (df)

# součet čtverců odchylek od průměru
# SS = S(y^2) - suma^2/n    >  součet čtverců - čtverec součtů
SS <- sum(data5$y^2) - ((sum(data5$y))^2)/n
SS
# variance = SS/(n-1)
s2y <- SS/(n-1)
s2y
# standard deviation - směrodatná odchylka (sd)
sd <- sqrt(s2y)
sd
# standard error (se) - střední chyba průměru
se <- sd/sqrt(n)
se
# variační koeficient %
V <- (sd/prumer)*100
V

# souhrnná popisná statistika pomocí nativní funkce v R, summary()
summary(data5$y)

