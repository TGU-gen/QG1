#### 4 Export dat do Excelu v R

# METODA: Balíček writexl 

# Instalace balíčku (pokud ještě není nainstalován)
install.packages("writexl")
library(writexl)

# Příklad 1: Export data3 do Excelu s jedním listem
data <- data3

# Export do Excelu
write_xlsx(data, "data3_export.xlsx")
cat("Data exportována do souboru: data_export.xlsx\n")

# Příklad 2: Export více listů do jednoho Excel souboru
list_data <- list(
  "Experiment" = data3,         # tento list si po otevření souboru smažeme
  "Experiment2" = data.frame(
    y = data3,
    Populace = c("A","B","A","B","A","B","A","B","A","B")
  )
)

write_xlsx(list_data, "data1b.xlsx")


